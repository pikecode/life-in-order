{
  "name": "life-in-order",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && tsx scripts/prepare-standalone.ts",
    "start": "HOSTNAME=127.0.0.1 node --env-file-if-exists=.env .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "content:import": "tsx scripts/import-content.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "test:recovery": "tsx --test tests/recovery.integration.ts",
    "db:semantic": "tsx scripts/migrate-semantic.ts",
    "content:embed": "tsx scripts/embed-content.ts",
    "test:search": "tsx scripts/evaluate-search.ts",
    "usage:report": "tsx scripts/report-usage.ts",
    "usage:prune": "tsx scripts/prune-usage.ts",
    "content:audit": "tsx scripts/audit-content.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
