DATABASE_URL=postgresql://localhost/life_in_order_dev
APP_URL=http://localhost:3000
# 恢复时单独设置；必须是独立空库，不能指向上方 DATABASE_URL。
# RESTORE_DATABASE_URL=postgresql://localhost/life_in_order_restore

# 可选语义检索：仅支持本机 Ollama，未配置时保留关键词检索。
# 下载模型后，从 http://127.0.0.1:11434/api/tags 获取该模型的完整 digest。
# EMBEDDING_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=bge-m3:latest
# EMBEDDING_MODEL_DIGEST=填写该模型的完整摘要
